{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2019",
    "noUnusedParameters": false
  },
  "compileOnSave": true,
  "include": [
    "src"
  ],
  "rules": {
    "object-curly-spacing": "off"
  }
}
